+/*
+ * Пейсинг передачи: байт доехал по линии, передатчик снова свободен.
+ *
+ * Вызывается по таймеру через char_transmit_time после того, как байт
+ * был отдан в backend. До этого момента THRE снят, и гость, который
+ * честно опрашивает LSR, ждёт. Гость, который не опрашивает, затирает
+ * байт следующим и теряет его, ровно как на железе.
+ */
+/* Пейсинг включён, если попросили явно или задали скорость линии. */
+static bool serial_pacing_on(SerialState *s)
+{
+    return s->xmit_pacing || s->xmit_pacing_baud;
+}
+
+static void serial_xmit_pacing_done(void *opaque)
+{
+    SerialState *s = opaque;
+
+    s->lsr |= UART_LSR_THRE;
+    s->lsr |= UART_LSR_TEMT;
+
+    if (!s->thr_ipending) {
+        s->thr_ipending = 1;
+        serial_update_irq(s);
+    }
+}
